{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["golar.config.ts"],
      "project": ["*.ts"],
      "ignoreDependencies": [
        "@favware/npm-deprecate",
        "@swc/core",
        "@types/ws",
        "cz-conventional-changelog"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-logger": {
      "entry": ["src/assertions.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-broker": {
      "entry": ["src/index.ts", "tests/types/*.ts"],
      "project": ["src/**/*.ts", "tests/types/*.ts"],
      "ignoreDependencies": ["@sapphire/pieces"]
    },
    "packages/plugin-cache": {
      "entry": ["src/index.ts", "tests/types/*.ts"],
      "project": ["src/**/*.ts", "tests/types/*.ts"]
    },
    "packages/plugin-gateway": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@sapphire/pieces"]
    },
    "packages/plugin-scheduled-tasks": {
      "entry": ["src/index.ts", "tests/types/*.ts"],
      "project": ["src/**/*.ts", "tests/types/*.ts"],
      "ignoreDependencies": ["@sapphire/pieces"]
    },
    "packages/plugin-i18next": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@wolfstar/i18next-type-generator"]
    }
  }
}
