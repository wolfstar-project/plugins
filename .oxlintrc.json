{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ]
  },
  "overrides": [
    {
      "files": ["packages/plugin-gateway/src/structures/**/*.ts"],
      "rules": {
        "typescript/no-unsafe-declaration-merging": "off"
      }
    },
    {
      "files": ["packages/plugin-gateway/src/**/*.ts", "packages/plugin-gateway/tests/**/*.ts"],
      "rules": {
        "no-underscore-dangle": [
          "warn",
          {
            "allow": [
              "_add",
              "_get",
              "_getInGuild",
              "_getShallow",
              "_hydrate",
              "_hydrateInGuild",
              "_resolveData"
            ],
            "allowAfterThis": true
          }
        ]
      }
    },
    {
      "files": [
        "packages/plugin-gateway/src/structures/channels/mixins/*.ts",
        "packages/plugin-gateway/src/structures/Structure.ts"
      ],
      "rules": {
        "no-unused-vars": ["error", { "varsIgnorePattern": "^(Type|Omitted)$" }]
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", ".turbo", "coverage"]
}
