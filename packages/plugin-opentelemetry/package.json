{
  "name": "@wolfstar/plugin-opentelemetry",
  "version": "0.1.0",
  "description": "Plugin for @wolfstar/http-framework that traces the bot with OpenTelemetry: a preload starting the SDK and a plugin opening one span per interaction",
  "keywords": [
    "http-framework",
    "opentelemetry",
    "otlp",
    "plugin",
    "sentry",
    "tracing",
    "wolfstar"
  ],
  "homepage": "https://github.com/wolfstar-project/plugins/tree/main/packages/plugin-opentelemetry",
  "bugs": {
    "url": "https://github.com/wolfstar-project/plugins/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfstar-project/plugins.git",
    "directory": "packages/plugin-opentelemetry"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/esm/preload.js"
  ],
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/esm/preload.d.ts",
        "default": "./dist/esm/preload.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/esm/plugin.d.ts",
        "default": "./dist/esm/plugin.js"
      }
    },
    "./module": {
      "import": {
        "types": "./dist/esm/module.d.ts",
        "default": "./dist/esm/module.js"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/esm/register.d.ts",
        "default": "./dist/esm/register.js"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "lint": "oxlint src --fix",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@types/node": "22.15.21",
    "@wolfstar/http-framework": "^6.2.2",
    "@wolfstar/kit": "^0.2.0",
    "@wolfstar/schema": "^0.9.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@wolfstar/http-framework": "^6.1.0",
    "@wolfstar/kit": "^0.2.0",
    "@wolfstar/schema": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "@wolfstar/kit": {
      "optional": true
    },
    "@wolfstar/schema": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
