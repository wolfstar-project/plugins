{
  "name": "root-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "Official plugins for @wolfstar/http-framework",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare": "husky || true",
    "lint": "oxlint packages && oxfmt --check packages",
    "lint:fix": "oxlint --fix packages && oxfmt --write packages",
    "test": "vitest run",
    "build": "turbo run build",
    "typecheck": "golar typecheck && golar tsc --noEmit -p packages/plugin-i18next/tsconfig.consumption.json && golar tsc --noEmit -p packages/plugin-cache/tsconfig.consumption.json && golar tsc --noEmit -p packages/plugin-gateway/tsconfig.consumption.json && golar tsc --noEmit -p packages/plugin-broker/tsconfig.consumption.json && golar tsc --noEmit -p packages/plugin-scheduled-tasks/tsconfig.consumption.json",
    "docs": "node scripts/generate-docs.mjs --options typedoc.json",
    "update": "pnpm update --interactive --recursive",
    "changeset": "changeset add",
    "publish": "pnpm build && changeset publish",
    "publish:snapshot": "node scripts/publish-snapshot.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@changesets/get-github-info": "^1.0.1",
    "@changesets/types": "^7.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@favware/npm-deprecate": "^2.0.0",
    "@sapphire/ts-config": "^5.0.3",
    "@swc/core": "^1.16.21",
    "@types/node": "22.15.21",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@wolfstar/kit": "^0.3.1",
    "@wolfstar/schema": "^0.12.0",
    "cz-conventional-changelog": "^3.3.0",
    "golar": "^0.1.11",
    "husky": "9.1.7",
    "knip": "6.44.1",
    "nano-staged": "1.0.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "pkg-pr-new": "^0.0.93",
    "publint": "^0.3.25",
    "semver": "^7.8.6",
    "tsdown": "^0.23.5",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "^5.1.0"
  },
  "nano-staged": {
    "*.{ts,mts,cts,tsx,mjs,cjs,js,jsx,json,jsonc,yml,yaml,md}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,mts,cts,tsx,mjs,cjs,js,jsx}": "oxlint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "^22.11 || ^24 || >=26"
  },
  "packageManager": "pnpm@12.18.0"
}
